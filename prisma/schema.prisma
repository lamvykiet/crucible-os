generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User Profile table (mapped to Supabase Auth user id)
model User {
  id                 String               @id // matches auth.users.id
  displayName        String
  email              String               @unique
  role               String               @default("user")
  createdAt          DateTime             @default(now())
  Transaction        Transaction[]
  Account            Account[]
  Project            Project[]
  ProjectAllocation  ProjectAllocation[]
  ProjectLedgerEntry ProjectLedgerEntry[]
  Category           Category[]
  Budget             Budget[]
  Debt               Debt[]
  Material           Material[]
  DictionaryItem     DictionaryItem[]
  Flashcard          Flashcard[]
  Idea               Idea[]
  DraftReceipt       DraftReceipt[]
  Vendor             Vendor[]
  ClassificationRule ClassificationRule[]
  OcrLog             OcrLog[]
  ExamAttempt        ExamAttempt[]
  VideoItem          VideoItem[]
  Asset              Asset[]
  Language           Language[]
  Notification       Notification[]
  DailyQuote         DailyQuote[]
  GrammarLesson      GrammarLesson[]
  SkillProgress      SkillProgress[]
  WritingSubmission  WritingSubmission[]
  VocabCourse        VocabCourse[]
  PracticeItem       PracticeItem[]
  SpeakingAttempt    SpeakingAttempt[]
  MockExam           MockExam[]
  DictationLog       DictationLog[]
  CollocationLog     CollocationLog[]
  BookStepProgress   BookStepProgress[]
  BookLesson         BookLesson[]
  BookUnitContent    BookUnitContent[]
  BookGrammarNote    BookGrammarNote[]
  Deck               Deck[]
  ReviewLog          ReviewLog[]
  StudyNote          StudyNote[]
  DailyTask          DailyTask[]
  LearnerPref        LearnerPref?
  Habit              Habit[]
  HabitEntry         HabitEntry[]
  HabitJournal       HabitJournal[]
  HabitTodo          HabitTodo[]
  FocusSession       FocusSession[]
}

// -----------------------------------------
// MODULE 1: FINANCE OS
// -----------------------------------------

model Transaction {
  id            String   @id @default(uuid())
  date          DateTime // receipt_date
  supplier      String
  type          String // Income | Expense | Transfer | Refund | Adjustment
  categoryGroup String // expense_group / income_group
  subGroup      String? // sub_group

  subtotal      Int @default(0)
  tax           Int @default(0)
  serviceCharge Int @default(0)
  discount      Int @default(0)
  totalAmount   Int

  paymentMethod String // cash | card | bank_transfer | e-wallet | unknown
  source        String // manual | ocr
  driveFileId   String?
  notes         String?

  /// Tiền ra/vào TÀI KHOẢN NÀO. `paymentMethod` chỉ nói "trả bằng thẻ", không
  /// nói thẻ nào — có ba thẻ tín dụng thì không dò ra được số dư từng thẻ.
  /// Để trống được: hơn 260 giao dịch cũ chưa gắn tài khoản vẫn phải chạy.
  accountId String?
  account   Account? @relation("TxAccount", fields: [accountId], references: [id], onDelete: SetNull)

  /// Đích đến, chỉ dùng cho giao dịch chuyển khoản — trả thẻ tín dụng là tiền
  /// rời tài khoản ngân hàng VÀ giảm dư nợ thẻ, thiếu vế này thì một trong hai
  /// số dư luôn sai.
  toAccountId String?
  toAccount   Account? @relation("TxToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)

  /// KHÔNG CÒN DÙNG từ 08/10/2026 — thay bằng `allocations` (một giao dịch chia
  /// được cho nhiều dự án). Giữ cột lại vì bản build cũ trên Vercel vẫn SELECT
  /// nó; xoá cột trước khi bản mới lên là mọi truy vấn giao dịch đều nổ. Mọi
  /// dòng đã được dời sang `ProjectAllocation` và đặt về null.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// Phần của giao dịch này thuộc về dự án nào, nhóm chi phí nào, bao nhiêu %.
  allocations ProjectAllocation[]

  userId String // owner
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items TransactionLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Tài khoản thanh toán: tài khoản ngân hàng, thẻ tín dụng, ví điện tử, tiền mặt.
///
/// Số dư KHÔNG lưu sẵn mà tính lại từ `openingBalance` cộng dồn các giao dịch
/// gắn với tài khoản. Lưu số dư sẵn thì mỗi lần sửa hay xoá một giao dịch cũ là
/// một lần số dư lệch âm thầm, và không có cách nào biết nó đã lệch.
model Account {
  id       String  @id @default(uuid())
  name     String
  /// bank | credit_card | cash | ewallet
  kind     String
  bank     String?
  /// Bốn số cuối, chỉ để nhận ra thẻ nào — không lưu số thẻ đầy đủ.
  last4    String?
  currency String  @default("VND")

  /// Số dư tại `openingDate`, do người dùng nhập. Với thẻ tín dụng đây là DƯ NỢ
  /// (số dương nghĩa là đang nợ).
  openingBalance Int       @default(0)
  openingDate    DateTime?

  /// Chỉ dành cho thẻ tín dụng.
  creditLimit  Int?
  /// Ngày chốt sao kê và ngày đến hạn thanh toán trong tháng.
  statementDay Int?
  dueDay       Int?

  /// active | closed
  status String  @default("active")
  notes  String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactionsFrom Transaction[]  @relation("TxAccount")
  transactionsTo   Transaction[]  @relation("TxToAccount")
  drafts           DraftReceipt[] @relation("DraftAccount")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

/// Một dự án kinh doanh nhỏ (ví dụ "Xưởng in 3D") để đo hiệu quả: đã bỏ vào bao
/// nhiêu, thu về bao nhiêu, bao giờ hoà vốn.
///
/// Không lưu số tổng nào cả — mọi con số tính lại từ các `Transaction` gắn
/// `projectId`, cùng lý do `Account` không lưu số dư: lưu sẵn thì sửa một giao
/// dịch cũ là số tổng lệch âm thầm.
model Project {
  id        String    @id @default(uuid())
  name      String
  /// active | paused | closed
  status    String    @default("active")
  /// Vốn dự định bỏ vào. Để so "đã tiêu bao nhiêu phần ngân sách".
  budget    Int?
  startDate DateTime?
  notes     String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]
  drafts       DraftReceipt[]
  allocations  ProjectAllocation[]
  ledger       ProjectLedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

/// Một phần của một giao dịch được phân bổ cho một dự án.
///
/// Đây là NGUỒN SỰ THẬT về "giao dịch này thuộc dự án nào": một hoá đơn thuê
/// máy có thể chia 60% dự án A, 40% dự án B; tổng các phần được phép dưới 100%
/// — phần còn lại là chi tiêu cá nhân. Sửa/xoá thoải mái; mỗi lần thay đổi,
/// `syncProjectLedger` (src/lib/projectLedger.ts) ghi bút toán đảo + ghi lại
/// vào `ProjectLedgerEntry` để sổ cái giữ nguyên lịch sử.
model ProjectAllocation {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// RAW_MATERIAL | MACHINERY | TESTING | LABOR | OVERHEAD | REVENUE
  /// (danh sách cố định ở `src/lib/projectCost.ts`).
  costCategory String
  /// 0 < % ≤ 100. Tổng các phần của một giao dịch ≤ 100.
  percentage   Float   @default(100)
  /// VND, = tổng giao dịch × %; phần lẻ làm tròn dồn vào phần cuối khi tổng đủ 100%.
  /// Tính lại mỗi khi tổng tiền giao dịch đổi.
  amount       Int
  notes        String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([transactionId, projectId, costCategory])
  @@index([projectId])
}

/// Sổ cái dự án — CHỈ GHI THÊM. Không bao giờ update hay delete một dòng: sửa
/// hay xoá giao dịch sinh bút toán đảo (REVERSAL) rồi bút toán mới (POSTING);
/// kết chuyển WIP sang giá vốn là một cặp COGS_TRANSFER.
///
/// `transactionId` cố ý KHÔNG có khoá ngoại: giao dịch bị xoá thì sổ vẫn phải
/// giữ dòng cũ và dòng đảo của nó. Số luỹ kế không lưu, tính lúc đọc.
model ProjectLedgerEntry {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  transactionId String?
  /// RAW_MATERIAL | MACHINERY | TESTING | LABOR | OVERHEAD | REVENUE
  costCategory  String
  /// WIP (chi phí dở dang) | COGS (giá vốn) | REVENUE (doanh thu)
  bucket        String
  /// DEBIT | CREDIT — luôn đi với `amount` dương.
  entryType     String
  amount        Int
  /// POSTING | REVERSAL | COGS_TRANSFER
  kind          String
  /// Ngày kinh tế: ngày giao dịch với POSTING, ngày sửa với REVERSAL.
  postingDate   DateTime
  note          String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([projectId, postingDate])
  @@index([transactionId])
}

model TransactionLine {
  id          String @id @default(uuid())
  productName String
  quantity    Float  @default(1)
  unitPrice   Int    @default(0)
  totalPrice  Int    @default(0)

  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

// Vùng chờ (staging) của luồng OCR hoá đơn.
//
// Bản cũ ghi bản nháp thành file `draft_<id>.json` trong thư mục Drive dùng
// chung: không lọc được theo người dùng, không có trạng thái, và mỗi lần mở
// hàng đợi phải tải từng file về để parse. Dự án "Sổ Chi Tiêu" trước đây dùng
// hai sheet Draft_Receipts/Draft_Items có cột `status` — đây là bản chuyển thể
// sang Postgres của đúng thiết kế đó.
//
// Vòng đời: Pending (vừa OCR xong, ảnh nằm ở Incoming_Invoices)
//        -> Approved (đã ghi Transaction, ảnh sang Approved_Invoices)
//        -> Rejected (người dùng bỏ, ảnh sang Trash_Invoices).
model DraftReceipt {
  id     String @id @default(uuid())
  status String @default("Pending") // Pending | Approved | Rejected

  // Mọi trường OCR đều nullable: nguyên tắc bất di bất dịch của luồng cũ là
  // "đọc không ra thì để null, không bao giờ đoán".
  date          DateTime?
  supplier      String?
  type          String    @default("Expense")
  categoryGroup String?
  subGroup      String?

  subtotal      Int?
  tax           Int?
  serviceCharge Int?
  discount      Int?
  totalAmount   Int?

  paymentMethod String? // cash | card | bank_transfer | e-wallet | unknown
  language      String? // vi | en | mixed
  notes         String?

  /// Trả bằng tài khoản/thẻ nào. `paymentMethod` chỉ nói "thẻ"; có ba thẻ tín
  /// dụng thì không dò ra thẻ nào. Chọn ở bước quét thì phải sống được tới bước
  /// duyệt, nên phải nằm trên bản nháp chứ không chỉ trên `Transaction`.
  accountId String?
  account   Account? @relation("DraftAccount", fields: [accountId], references: [id], onDelete: SetNull)

  /// KHÔNG CÒN DÙNG — thay bằng `projectSplits`. Giữ cột vì cùng lý do với
  /// `Transaction.projectId`.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// Phân bổ dự án chọn lúc quét: `[{ projectId, costCategory, percentage }]`.
  /// JSON chứ không phải bảng vì bản nháp chỉ sống tới lúc duyệt — khi đó nó
  /// thành `ProjectAllocation` thật. Phải đi qua đây, nếu không lựa chọn lúc
  /// quét bốc hơi ở bước duyệt (cùng bài học với `accountId`).
  projectSplits Json?

  // Danh sách fileId trên Drive, phân tách bằng dấu phẩy (một hoá đơn dài có
  // thể được chụp thành nhiều ảnh).
  driveFileIds  String
  driveFileName String?

  // Giao dịch được sinh ra khi duyệt. Giữ lại để nút "xoá giao dịch vừa tạo"
  // trong hộp thoại trùng lặp biết phải xoá bản ghi nào.
  transactionId String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items DraftItem[]

  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, status])
}

model DraftItem {
  id          String @id @default(uuid())
  productName String
  quantity    Float  @default(1)
  unitPrice   Int    @default(0)
  totalPrice  Int    @default(0)

  // Gemini đề xuất nhóm chi tiêu cho từng dòng kèm độ tin cậy. Chưa dùng để tự
  // động phân loại, nhưng lưu sẵn để sau này port Classification_Rules.
  suggestedCategoryGroup String?
  confidence             Float?

  draftId String
  draft   DraftReceipt @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
}

// Nhà cung cấp đã gặp, dựng dần từ các hoá đơn đã duyệt.
//
// `normalizedName` là tên đã bỏ dấu/hạ chữ thường (xem normalizeSupplier trong
// src/lib/invoice.ts) — vừa dùng để chống trùng, vừa là khoá so khớp quy tắc.
model Vendor {
  id                   String  @id @default(uuid())
  vendorName           String
  normalizedName       String
  defaultCategoryGroup String?
  notes                String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, normalizedName])
}

// Quy tắc tự phân loại hoá đơn.
//
// Hệ "Sổ Chi Tiêu" chạy theo thứ tự: quy tắc trước, Gemini là phương án dự
// phòng, và mỗi lần người dùng sửa tay có thể lưu lại thành quy tắc mới
// (source = "learned"). Đây là bản chuyển thể của sheet Classification_Rules.
model ClassificationRule {
  id String @id @default(uuid())

  // vendor | product_keyword | note_keyword
  matchType  String
  // Luôn lưu ở dạng đã chuẩn hoá để so khớp không phụ thuộc dấu và chữ hoa.
  matchValue String

  transactionType String?
  categoryGroup   String
  subGroup        String?

  // Số nhỏ được xét trước. Quy tắc học được đặt 50, quy tắc gõ tay mặc định 100,
  // nên một lần sửa tay gần đây luôn thắng quy tắc chung chung cũ.
  priority Int     @default(100)
  active   Boolean @default(true)
  source   String  @default("manual") // manual | learned

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, active, priority])
}

// Nhật ký OCR — trước đây mọi lỗi Gemini chỉ nằm trong console của server, nên
// không có cách nào biết hoá đơn nào hỏng, hỏng vì sao, hay mất bao lâu.
model OcrLog {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())

  fileId     String?
  fileName   String?
  status     String // OK | ERROR | INFO
  message    String
  durationMs Int?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
}

// Một lượt thi thử sinh ra từ một tài liệu.
//
// Tab Thi thử trước đây liệt kê ba đề viết cứng ("CFA Level 1 - Mock Exam A",
// 135 phút, 90 câu) không hề tồn tại ở đâu, và nút Bắt đầu không có handler.
// Đề giờ được sinh từ chính tài liệu người dùng đang học.
//
// Câu hỏi lưu nguyên cụm JSON thay vì tách bảng riêng: đề là ảnh chụp một lần,
// không phải ngân hàng câu hỏi dùng lại — tách bảng chỉ thêm việc mà không thêm
// khả năng nào.
model ExamAttempt {
  id String @id @default(uuid())

  sourceFileId String
  sourceName   String

  questionCount Int
  correctCount  Int     @default(0)
  completed     Boolean @default(false)

  /// JSON: [{ question, options[], correctIndex, explanation, chosenIndex }]
  questions String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId, createdAt])
}

// Video lưu từ TikTok / Facebook / YouTube.
//
// Ứng dụng KHÔNG tự tải video: nó chạy trên Vercel, nơi hệ thống file chỉ đọc,
// function bị giới hạn 60 giây và không cài được yt-dlp. Điện thoại tải qua một
// Shortcut, rồi đẩy file lên `/api/video/upload`.
//
// Bảng này giữ phần mà Drive không giữ được: link gốc, nền tảng, và đề tài —
// đúng ba thứ khiến một video lưu 6 tháng trước vẫn còn tra lại được.
model VideoItem {
  id String @id @default(uuid())

  sourceUrl String
  // tiktok | facebook | youtube | instagram | other
  platform  String
  topic     String
  // Nhãn phân loại con, do người dùng tự gõ: đề tài "3D Design" có "Mẫu thiết
  // kế", "Hướng dẫn in", "Trick in"...
  //
  // Cố tình KHÔNG tạo thư mục Drive lồng thêm một tầng: Shortcut trên iPhone
  // chỉ chọn được đề tài cấp một, thêm tầng nữa là mọi lượt upload rơi vào sai
  // chỗ. Đây là nhãn thuần trong DB, dùng để lọc và gom nhóm ở giao diện, nên
  // đổi tên nhãn không đụng gì tới file đã nằm trên Drive.
  subTopic  String?
  title     String?
  note      String?

  // pending: đã dán link, chờ Shortcut đẩy file lên
  // saved:   file đã nằm trên Drive
  status String @default("pending")

  driveFileId   String?
  driveFileName String?
  sizeBytes     Int?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  savedAt   DateTime?

  @@index([userId, status])
  @@index([userId, topic])
}

model Category {
  id   String @id @default(uuid())
  kind String // expense_group | income_group

  // `name` là tên CHUẨN: Transaction.categoryGroup, Budget.categoryGroup,
  // Vendor.defaultCategoryGroup và ClassificationRule.categoryGroup đều khớp
  // với nó bằng chuỗi. Đổi `name` là phải dời cả bốn bảng đó.
  //
  // Giữ tiếng Anh làm chuẩn vì process-ocr có fallback viết cứng "Other", và
  // dữ liệu sẵn có đều dùng tên tiếng Anh.
  name   String
  // Nhãn tiếng Việt, chỉ dùng để hiển thị. Rỗng thì giao diện lùi về `name`.
  nameVi String?

  active   Boolean    @default(true)
  parentId String?
  parent   Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children Category[] @relation("SubCategories")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Budget {
  id            String  @id @default(uuid())
  periodType    String // monthly | yearly
  period        String // YYYY-MM | YYYY
  categoryGroup String // matches Category.name
  amount        Int
  notes         String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -----------------------------------------
// MODULE 2 & 3: KNOWLEDGE HUB & LEARNING HUB
// -----------------------------------------

// Tài liệu trong Knowledge Hub, đồng thời là nơi cache văn bản đã trích ra.
//
// Bảng này trước đây hoàn toàn trống và không có chỗ nào ghi vào: module
// Knowledge đọc thẳng từ Drive, còn khung chat chỉ gửi cho AI mỗi cái TÊN file.
// Nay mỗi lần mở một tài liệu, nội dung được trích một lần rồi lưu ở đây, nên
// những câu hỏi sau không phải tải lại file và không tốn thêm quota Gemini.
model Material {
  id          String  @id @default(uuid())
  driveFileId String  @unique
  title       String
  type        String // e.g. "pdf"
  domain      String?
  mimeType    String?

  // Văn bản đã trích (Google Docs/Sheets, .docx/.xlsx, .txt/.md). Cache hợp lệ
  // khi `sourceModifiedAt` còn khớp `modifiedTime` bên Drive — file sửa trên
  // Drive thì tự trích lại.
  contentText      String?
  contentChars     Int?
  sourceModifiedAt DateTime?
  contentFetchedAt DateTime?

  // PDF và ảnh không chép ra text mà đẩy thẳng lên Gemini Files API: chép toàn
  // văn một PDF 7,67 MB mất 260 giây, còn upload chỉ 2,8 giây. Gemini giữ tệp
  // 48 giờ, hết hạn thì lần mở sau tự đẩy lại.
  geminiFileUri       String?
  geminiFileName      String?
  geminiFileExpiresAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  annotations DocumentAnnotation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DocumentAnnotation {
  id       String  @id @default(uuid())
  content  String
  position String // JSON string
  comment  String?

  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Idea / Project Tracker.
//
// Trước đây IdeaTrackerTab.tsx render một mảng 3 dự án viết cứng và không nút
// nào có onClick — tính năng hoàn toàn không có nền tảng dữ liệu.
model Idea {
  id           String   @id @default(uuid())
  title        String
  description  String?
  // active | completed | archived
  status       String   @default("active")
  // Mốc để tính "bỏ trống > 30 ngày". Bản cũ dùng cờ `stale` viết cứng.
  lastActiveAt DateTime @default(now())
  // Dàn ý do /api/ai/blueprint sinh ra, lưu lại để khỏi gọi AI nhiều lần.
  blueprint    String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

model DictionaryItem {
  id               String   @id @default(uuid())
  term             String
  definition       String
  phonetic         String?
  example          String?
  domain           String?
  tags             String[]
  crossDomainLinks String? // JSON string

  // ── Phần thêm cho module ngôn ngữ ──────────────────────────────────────
  // `phonetic` giữ nguyên vai trò "cách đọc", nhưng đọc theo hệ nào là do
  // Language.phoneticSystem quyết định: IPA cho Anh/Pháp, Pinyin cho Quan
  // Thoại, Jyutping cho Quảng Đông, Romaja cho Hàn. Nhờ vậy không phải đẻ ra
  // mỗi tiếng một cột.
  tone               String? // "3", "2-1"... chỉ dùng cho tiếng có thanh điệu
  exampleTranslation String? // bản dịch câu ví dụ
  imageUrl           String? // ảnh minh hoạ cho thẻ
  audioUrl           String? // file phát âm mẫu
  orderIndex         Int     @default(0)

  // ── Vòng ôn của riêng từ này ────────────────────────────────────────────
  // Khác giáo trình theo ngày (`VocabSet`) ở chỗ mốc bắt đầu là NGÀY NGƯỜI
  // DÙNG BẤM, không phải ngày mở bộ. Đánh dấu một từ hôm nay thì mười ngày nữa
  // nó quay lại, không phụ thuộc bộ nào.
  /// Null = mới đánh dấu để đó, chưa vào vòng ôn.
  learnStartedAt DateTime?
  /// Đã ôn qua bao nhiêu vòng, 0..5.
  reviewCycles   Int       @default(0)
  lastReviewedAt DateTime?

  deckId     String?
  deck       Deck?     @relation(fields: [deckId], references: [id], onDelete: SetNull)
  languageId String?
  language   Language? @relation(fields: [languageId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  flashcard Flashcard?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Flashcard {
  id    String @id @default(uuid())
  front String
  back  String

  // FSRS Algorithm Fields
  stability     Float     @default(0)
  difficulty    Float     @default(0)
  elapsedDays   Int       @default(0)
  scheduledDays Int       @default(0)
  reps          Int       @default(0)
  state         Int       @default(0) // 0: New, 1: Learning, 2: Review, 3: Relearning
  lastReview    DateTime?
  dueDate       DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemId         String?         @unique
  dictionaryItem DictionaryItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Debt {
  id             String    @id @default(uuid())
  name           String
  type           String // Mortgage, Auto Loan, Personal, Credit Card, etc.
  startDate      DateTime
  dueDate        DateTime?
  principal      Int
  remaining      Int
  monthlyPayment Int
  interestRate   Float
  status         String    @default("active") // active | settled

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  schedule DebtSchedule[]

  // Tài sản mà khoản vay này dùng để mua, hoặc đem thế chấp.
  //
  // Chiều quan hệ đặt ở đây chứ không phải ở `Asset.debtId`: MỘT tài sản có thể
  // gánh NHIỀU khoản vay. Căn nhà này vừa có khoản vay mua nhà vừa có khoản vay
  // thế chấp lấy thêm tiền — để một chiều thì vốn chủ sở hữu tính thiếu nguyên
  // một khoản nợ mà không báo gì.
  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Lịch trả nợ từng kỳ.
//
// `Debt` chỉ giữ được một dòng tóm tắt, không đủ cho khoản vay gốc đều lãi thả
// nổi: mỗi kỳ có ngày đến hạn riêng (mùng 10, lùi về thứ Sáu nếu rơi cuối
// tuần), số ngày tính lãi riêng, và lãi suất riêng — khoản vay mua nhà đã đổi
// lãi 16 lần trong 76 kỳ đầu.
//
// Lãi = openingBalance × interestRate × interestDays / 365. Công thức này khớp
// tới từng đồng với bảng của ngân hàng.
//
// `status` phân biệt kỳ ĐÃ CHỐT với kỳ TẠM TÍNH. Kỳ tạm tính dựng theo giả định
// lãi suất hiện hành giữ nguyên tới hết — giả định gần như chắc chắn sai với
// lãi thả nổi, nên giao diện phải nói rõ, không được trình bày như số thật.
//
// Mọi cột đều sửa được, kể cả kỳ quá khứ: khi thương lượng được khoản hoàn thì
// cấn trừ ngược vào kỳ cũ, và các kỳ sau được tính lại từ dư nợ mới.
model DebtSchedule {
  id String @id @default(uuid())

  debtId String
  debt   Debt   @relation(fields: [debtId], references: [id], onDelete: Cascade)

  period         Int // 1..tenor
  dueDate        DateTime
  interestDays   Int
  openingBalance Int // dư nợ đầu kỳ
  principal      Int
  interest       Int
  payment        Int // principal + interest
  closingBalance Int // dư nợ cuối kỳ
  interestRate   Float // %/năm áp cho kỳ này
  status         String   @default("projected") // paid | projected
  note           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([debtId, period])
  @@index([debtId, dueDate])
}

// Tài sản và công cụ dụng cụ.
//
// Có hai loại giá trị và đừng lẫn chúng:
//
//   GIÁ TRỊ SỔ SÁCH — nguyên giá trừ khấu hao luỹ kế. Dùng cho thiết bị: laptop
//   mua 30 triệu, đời hữu dụng 4 năm, sau 2 năm còn 15 triệu trên sổ.
//
//   GIÁ TRỊ ĐỊNH GIÁ (`currentValue`) — số bạn tự đặt khi biết giá thị trường.
//   Bất động sản không khấu hao mà lên xuống theo thị trường, nên nhà thì dùng
//   ô này. Có `currentValue` thì nó đè lên giá trị sổ sách.
//
// VỐN CHỦ SỞ HỮU của một tài sản mua bằng nợ = giá trị hiện tại − dư nợ còn
// lại của khoản vay gắn với nó. Trả gốc KHÔNG làm tài sản đắt lên, nó làm nợ
// nhỏ đi — vốn chủ sở hữu tự tăng đúng bằng số đó. Cộng gốc vào giá trị tài
// sản là đếm hai lần.
model Asset {
  id       String @id @default(uuid())
  name     String
  // Real Estate | Vehicle | Electronics | Furniture | Equipment | Other
  category String

  acquisitionDate DateTime
  acquisitionCost Int

  // straight_line | none. `none` dành cho thứ không mòn theo sổ sách (nhà, đất).
  depreciationMethod String @default("straight_line")
  // 0 nghĩa là không khấu hao, bất kể `depreciationMethod`.
  usefulLifeMonths   Int    @default(0)
  // Giá trị còn lại khi hết đời hữu dụng; khấu hao không bao giờ ăn xuống dưới mức này.
  salvageValue       Int    @default(0)

  // Định giá lại. Có giá trị thì đè lên giá trị sổ sách.
  currentValue  Int?
  valuationDate DateTime?

  // owned | sold | written_off
  status         String    @default("owned")
  disposalDate   DateTime?
  disposalAmount Int?

  // Các khoản vay gắn với tài sản này. Xem chú thích ở `Debt.assetId`.
  debts Debt[]

  notes String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════
//  MODULE NGÔN NGỮ
//
//  Learning Hub phải chạy được cho tiếng Anh, Quan Thoại, Quảng Đông, Hàn và
//  Pháp — năm thứ tiếng có hình dạng rất khác nhau:
//
//    Anh / Pháp     chữ Latin,  phiên âm IPA,      không thanh điệu
//    Quan Thoại     chữ Hán,    phiên âm Pinyin,   4 thanh + thanh nhẹ
//    Quảng Đông     chữ Hán,    phiên âm Jyutping, 6 thanh
//    Hàn            Hangul,     phiên âm Romaja,   không thanh điệu
//
//  Nếu viết cứng theo tiếng Anh thì thêm tiếng thứ hai là phải đập đi làm lại.
//  Nên chỗ khác nhau được đẩy hết vào cấu hình của `Language`, còn thẻ từ vựng
//  giữ đúng một hình dạng chung. Thêm tiếng thứ sáu = thêm một dòng dữ liệu.
// ═══════════════════════════════════════════════════════════════════════════

/// Một thứ tiếng đang học, kèm những quy ước riêng của nó.
model Language {
  id         String  @id @default(uuid())
  code       String // en, fr, cmn (Quan Thoại), yue (Quảng Đông), ko
  name       String // tên hiển thị, ví dụ "Tiếng Quảng Đông"
  nativeName String? // 廣東話, 한국어...

  /// latin | hanzi | hangul — quyết định có bật phần luyện viết chữ hay không.
  script         String  @default("latin")
  /// ipa | pinyin | jyutping | romaja — nhãn hiện trên ô "cách đọc".
  phoneticSystem String  @default("ipa")
  /// Có thanh điệu thì mới hiện phần luyện thanh.
  hasTones       Boolean @default(false)
  toneCount      Int     @default(0)
  /// CEFR | HSK | TOPIK — thang cấp độ dùng để xếp bộ thẻ.
  levelScale     String  @default("CEFR")

  sortOrder Int     @default(0)
  active    Boolean @default(true)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  decks Deck[]
  items DictionaryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, code])
}

/// Bộ thẻ. Dùng cho cả ngôn ngữ lẫn các lĩnh vực khác.
///
/// `languageId` và `domain` loại trừ nhau: bộ thuộc một thứ tiếng, hoặc thuộc
/// một lĩnh vực (Finance, 3D Design...). Để chung một bảng là có chủ ý — khi
/// nhân bản logic sang lĩnh vực khác thì không phải viết lại gì.
model Deck {
  id          String  @id @default(uuid())
  name        String
  description String?
  level       String? // A1..C2, HSK1.., TOPIK1..
  topic       String?

  /// Vị trí trong lộ trình. Học xong bộ này mới mở bộ có orderIndex kế tiếp.
  orderIndex  Int       @default(0)
  /// active | paused — bộ tạm dừng không đưa thẻ vào hàng ôn hằng ngày.
  status      String    @default("active")
  isPreset    Boolean   @default(false)
  completedAt DateTime?

  languageId String?
  language   Language? @relation(fields: [languageId], references: [id], onDelete: Cascade)
  domain     String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items DictionaryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, languageId, orderIndex])
  @@index([userId, domain])
}

/// Nhật ký từng lượt ôn.
///
/// `Flashcard` chỉ giữ trạng thái hiện tại của thẻ, nên không trả lời được
/// "hôm 12/08 đã học những gì". Bảng này ghi lại từng lượt để dựng lịch sử
/// dạng lịch tháng, biểu đồ thống kê, và chuỗi ngày học.
model ReviewLog {
  id          String  @id @default(uuid())
  flashcardId String?
  itemId      String?
  deckId      String?
  languageId  String?

  grade   Int // 1..4 theo thang FSRS
  state   Int // trạng thái thẻ SAU lượt ôn này
  /// flashcard | quick | fill | listen | tone | write | pronounce
  mode    String   @default("flashcard")
  correct Boolean?

  reviewedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, reviewedAt])
  @@index([userId, languageId, reviewedAt])
}

/// Giấy nhớ, gắn với một ngày cụ thể để xem lại cùng lịch sử học.
model StudyNote {
  id       String   @id @default(uuid())
  body     String
  noteDate DateTime
  color    String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, noteDate])
}

/// Việc cần làm trong ngày, và thử thách hằng ngày.
model DailyTask {
  id       String   @id @default(uuid())
  taskDate DateTime
  /// review | newCards | listen | pronounce | read | pomodoro | challenge
  kind     String
  label    String?
  target   Int      @default(1)
  progress Int      @default(0)
  reward   Int      @default(0)
  visible  Boolean  @default(true)
  color    String?

  completedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, taskDate])
}

/// Tuỳ chọn học và phần thưởng của người dùng.
///
/// Gom một dòng cho mỗi người thay vì rải cột vào `User` — phần này còn phình
/// thêm khi làm tới ảnh nền, hiệu ứng và cửa hàng.
model LearnerPref {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Phần thưởng
  diamonds      Int @default(0)
  streakShields Int @default(0)

  // Không gian học
  background          String? // ảnh nền đang dùng
  unlockedBackgrounds String[] // những ảnh đã mở khoá
  videoBackground     String?
  weatherEffect       String   @default("none")
  contentAlign        String   @default("center")
  colorTheme          String   @default("default")

  // Ngôn ngữ
  //
  // Hai thứ khác nhau, và lẫn chúng là lẫn cả trải nghiệm:
  //  - `translationLanguage` là tiếng dùng để VIẾT NGHĨA của từ và bản dịch câu
  //    ví dụ. Học tiếng Hàn mà đặt cái này là "en" thì 물 → "water".
  //  - Ngôn ngữ giao diện nằm ở localStorage qua LanguageContext, không lưu ở
  //    đây. Để hai nơi cùng giữ một giá trị là tự chuốc lấy cảnh chúng lệch nhau.
  translationLanguage String @default("vi")

  /// Đã qua màn khởi đầu chưa. Null = lần đầu mở Learning Hub.
  onboardedAt DateTime?

  // Cách học
  newCardLimit      Int     @default(10)
  relearnLimit      Int     @default(20)
  skipExerciseOnNew Boolean @default(true)
  lowercaseAnswers  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------
// MODULE 4: HABITS — theo dõi và tạo thói quen
// -----------------------------------------

/// Một thói quen.
///
/// `kind` chia làm hai họ hoàn toàn khác nhau về cách đo:
/// - `build`  — làm đủ chỉ tiêu mỗi kỳ (uống 8 cốc nước/ngày, đọc 200 trang/tuần).
/// - `quit`   — *không* làm, đo bằng khoảng thời gian đã nhịn được kể từ
///              `quitSince`. Không có chỉ tiêu, không có ô tick hằng ngày.
///
/// Mọi cột đo lường đều để ở đây chứ không rải sang bảng khác: một thói quen
/// đổi từ "3 lần/ngày" sang "200 trang/tuần" chỉ là sửa `unit/target/period`,
/// lịch sử trong `HabitEntry` giữ nguyên và vẫn đọc được.
model Habit {
  id   String  @id @default(uuid())
  name String
  /// Câu "nếu — thì" gắn thói quen vào một mốc có sẵn trong ngày:
  /// "Sau khi pha cà phê sáng, tôi sẽ đọc 10 trang". Đây là phần quyết định
  /// thói quen có sống được hay không, nên nó là một trường riêng chứ không
  /// phải ghi chú chung chung.
  cue  String?

  /// build | quit
  kind  String  @default("build")
  /// Nhóm hiển thị trên trang Hôm nay: daily | health | mind | work
  group String  @default("daily")
  /// Tên token màu: accent | success | warning | error | info | primary
  color String  @default("accent")
  /// Tên icon Lucide, ví dụ "droplet". Rỗng thì dùng icon mặc định theo nhóm.
  icon  String?

  /// Đơn vị đo — xem UNITS trong src/lib/habits.ts.
  unit   String @default("times")
  /// Chỉ tiêu cho mỗi kỳ.
  target Int    @default(1)
  /// day | week | month — chỉ tiêu tính trên kỳ nào.
  period String @default("day")
  /// Mỗi lần bấm "+" thì cộng bao nhiêu (bước 1000 cho số bước chân...).
  step   Int    @default(1)

  /// Các thứ trong tuần áp dụng, 0 = Chủ nhật … 6 = Thứ bảy.
  /// Mảng rỗng nghĩa là mọi ngày. Ngày không áp dụng thì không tính vào chuỗi
  /// và không kéo tỷ lệ hoàn thành xuống.
  weekdays Int[]

  /// Giờ nhắc và khối thời gian trên lịch tuần, dạng "HH:MM" theo giờ người dùng.
  reminderAt      String?
  scheduleStart   String?
  scheduleMinutes Int?

  /// Nguồn tiến độ: manual | review | focus | noSpend.
  ///
  /// Khác "manual" thì tiến độ trong ngày do máy chủ đếm lại từ dữ liệu thật
  /// của module khác (ReviewLog, FocusSession, Transaction) — người dùng không
  /// bấm gì cả, và con số không bao giờ lệch với sổ gốc.
  autoSource String @default("manual")

  /// Chỉ dùng cho `kind = quit`: mốc bắt đầu đếm. Bấm "tái phạm" là đặt lại mốc
  /// này về hiện tại, đồng thời ghi một dòng HabitEntry để giữ lịch sử.
  quitSince DateTime?

  sortOrder  Int       @default(0)
  /// Lưu kho thay vì xoá: biểu đồ năm và nhật ký vẫn còn chỗ dựa.
  archivedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  entries  HabitEntry[]
  journals HabitJournal[]
  sessions FocusSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, archivedAt, sortOrder])
}

/// Một ngày của một thói quen.
///
/// Chỉ tồn tại khi có chuyện xảy ra trong ngày đó — không sinh sẵn dòng 0 cho
/// mọi ngày. "Không có dòng" nghĩa là chưa làm, và đó là sự thật, không phải
/// thiếu dữ liệu.
model HabitEntry {
  id      String @id @default(uuid())
  habitId String
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)

  /// Nửa đêm của ngày lịch người dùng, lưu như mốc UTC — cùng quy ước với
  /// `Transaction.date` và `DailyTask.taskDate`.
  entryDate DateTime
  /// Đã làm được bao nhiêu, theo `Habit.unit`. Với thói quen `quit` thì đây là
  /// số lần tái phạm trong ngày.
  amount    Int      @default(0)
  note      String?
  /// Ngày nghỉ có chủ ý: không tính là hoàn thành, nhưng cũng không phá chuỗi.
  skipped   Boolean  @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([habitId, entryDate])
  @@index([userId, entryDate])
}

/// Nhật ký: một dòng cảm xúc gắn với ngày, và tuỳ chọn gắn với một thói quen.
model HabitJournal {
  id        String   @id @default(uuid())
  entryDate DateTime
  body      String
  /// 1..5 — để rỗng nếu người dùng không muốn chấm.
  mood      Int?
  energy    Int?

  habitId String?
  habit   Habit?  @relation(fields: [habitId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, entryDate])
}

/// Việc cần làm, kèm giờ hẹn. Tách khỏi `DailyTask` của Learning Hub: bảng kia
/// là khung đếm nhiệm vụ học sinh ra mỗi ngày, bảng này là việc do người dùng
/// tự viết và sống tới khi xong.
model HabitTodo {
  id      String    @id @default(uuid())
  title   String
  note    String?
  dueDate DateTime?
  /// "HH:MM" theo giờ người dùng; rỗng nghĩa là "trong ngày".
  dueTime String?
  flagged Boolean   @default(false)

  doneAt DateTime?

  sortOrder Int @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, doneAt, dueDate])
}

/// Một phiên tập trung đã chạy xong (đếm ngược hoặc bấm giờ).
///
/// Ghi phút thật đã chạy, không ghi phút đặt ra: dừng giữa chừng thì số nhỏ hơn.
/// Thói quen nào có `autoSource = focus` sẽ cộng dồn từ bảng này.
model FocusSession {
  id      String  @id @default(uuid())
  habitId String?
  habit   Habit?  @relation(fields: [habitId], references: [id], onDelete: SetNull)

  /// countdown | stopwatch
  mode          String  @default("countdown")
  targetMinutes Int     @default(0)
  /// Số giây thực sự đã chạy, không tính lúc tạm dừng.
  seconds       Int     @default(0)
  note          String?

  startedAt DateTime
  endedAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, endedAt])
}

/// Thông báo trong ứng dụng.
///
/// Chuông ở thanh trên. Đây là thông báo *của hệ thống gửi cho người dùng*
/// (chuỗi sắp đứt, thử thách sắp hết giờ, tính năng mới), không phải nhật ký
/// hoạt động — thứ đó đã có ở `ReviewLog`.
model Notification {
  id    String  @id @default(uuid())
  title String
  body  String?
  /// info | streak | challenge | system
  kind  String  @default("info")
  /// Đường dẫn để bấm vào là nhảy thẳng tới chỗ cần làm.
  href  String?

  readAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Câu trích mỗi ngày.
///
/// Sinh bằng AI rồi giữ lại, vì một câu phải đứng yên suốt cả ngày: mỗi lần
/// mở trang lại ra câu khác thì nó không còn là "câu hôm nay" nữa, và cũng
/// tốn một lượt gọi AI cho mỗi lần tải trang.
model DailyQuote {
  id          String   @id @default(uuid())
  quoteDate   DateTime
  text        String
  /// Bản dịch sang ngôn ngữ người dùng đã chọn.
  translation String?
  author      String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, quoteDate])
}

/// Một bài ngữ pháp đã được sinh và giữ lại.
///
/// Khung chương trình nằm trong code (`src/lib/grammarSyllabus.ts`) vì thứ tự
/// học cần ổn định. Còn *nội dung* từng bài thì sinh bằng AI lần đầu mở rồi
/// lưu ở đây: mở lại là đọc từ bảng, không gọi AI nữa — vừa nhanh, vừa để bài
/// học không đổi chữ mỗi lần xem.
///
/// `langCode` để dành cho việc mở rộng sang tiếng Trung, Hàn, Pháp: cùng một
/// hệ thống, khác khung chương trình và khác nội dung.
model GrammarLesson {
  id       String @id @default(uuid())
  /// Khoá của điểm ngữ pháp trong khung chương trình.
  pointId  String
  /// Mã thứ tiếng đang học. Mặc định "en".
  langCode String @default("en")

  summary    String
  useWhen    String
  /// JSON: [{ pattern, note }]
  structures String
  /// JSON: [{ sentence, note }]
  examples   String
  /// JSON: [{ prompt, options[], correctIndex, explanation }] — sinh riêng khi
  /// người dùng bấm sang tab luyện tập, nên có thể còn trống.
  exercises  String?

  // Tiến độ
  viewedAt      DateTime?
  practiceCount Int       @default(0)
  correctCount  Int       @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, pointId, langCode])
  @@index([userId, langCode])
}

/// Tiến độ của một kỹ năng trong một thứ tiếng.
///
/// Kỹ năng (nghe, nói, đọc, viết, ngữ pháp, phát âm, từ vựng) là *chức năng của
/// ứng dụng*, không phải thư mục Drive. "Luyện nói" không phải một chỗ chứa tài
/// liệu — nó là một chế độ học, nên nó không thể là thư mục.
model SkillProgress {
  id         String @id @default(uuid())
  languageId String
  /// listening | speaking | reading | writing | grammar | pronunciation | vocabulary
  skill      String

  xp          Int @default(0)
  lessonsDone Int @default(0)
  /// Tổng số phút đã luyện, để biết kỹ năng nào đang bị bỏ quên.
  minutes     Int @default(0)

  lastPracticedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, languageId, skill])
  @@index([userId, languageId])
}

/// Một bài viết đã nộp, kèm nhận xét của AI.
///
/// Giữ lại cả đề, bài làm và nhận xét: tiến bộ trong kỹ năng viết chỉ nhìn thấy
/// được khi đọc lại bài cũ, chứ một con số band đứng một mình thì không nói lên
/// điều gì.
///
/// `band` là ƯỚC LƯỢNG do AI chấm, không phải điểm giám khảo. Giao diện phải nói
/// rõ điều đó.
model WritingSubmission {
  id         String  @id @default(uuid())
  languageId String?
  /// ielts | general — để sau này thêm định dạng thi khác.
  examType   String  @default("ielts")
  /// task1 | task2
  taskType   String

  prompt     String
  /// JSON: mô tả biểu đồ hoặc dữ liệu kèm theo đề Task 1.
  promptData String?

  response     String
  wordCount    Int
  minutesSpent Int?

  // Chấm điểm
  band     Float?
  /// JSON: { taskResponse, coherence, lexis, grammar } — bốn tiêu chí, thang 0-9.
  criteria String?
  /// JSON: [{ quote, issue, better }] — lỗi cụ thể kèm cách sửa.
  feedback String?
  summary  String?
  gradedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Giáo trình từ vựng theo ngày.
///
/// Đây là hệ RIÊNG, chạy song song với thẻ ghi nhớ FSRS chứ không thay thế.
/// Hai hệ có triết lý khác nhau và không trộn được:
///
///   FSRS        giãn cách theo mức độ nhớ từng thẻ — tối ưu cho trí nhớ
///   Giáo trình  lịch cố định 10 ngày, 5 vòng — dễ đoán, hợp học theo khoá
///
/// Người học chọn hệ nào hợp với mình, và một từ có thể nằm ở cả hai.
model VocabCourse {
  id       String @id @default(uuid())
  langCode String @default("en")
  /// B1 | B2 | C1 | C2, hoặc cấp của giáo trình gốc khi học theo sách.
  level    String

  /// Nguồn của giáo trình, cũng là CỜ PHÂN LOẠI gắn vào từng từ khi đưa vào
  /// ngân hàng từ vựng. "ai" là giáo trình do AI bốc từ theo cấp độ; còn lại là
  /// id của một bộ rút từ giáo trình có sẵn, ví dụ "evu-elementary".
  ///
  /// Mặc định "ai" chứ không để trống: Postgres coi mỗi NULL là một giá trị
  /// khác nhau, nên nếu để null thì ràng buộc duy nhất bên dưới hết tác dụng và
  /// một người có thể tạo trùng nhiều giáo trình AI cùng cấp.
  source      String  @default("ai")
  /// Tên hiển thị. Trống thì giao diện tự dựng từ cấp độ.
  title       String?
  /// Số ngày của giáo trình; mỗi ngày 10 từ.
  totalDays   Int     @default(0)
  wordsPerDay Int     @default(10)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sets VocabSet[]

  createdAt DateTime @default(now())

  @@unique([userId, langCode, level, source])
}

/// Một ngày trong giáo trình: mười từ, kèm lịch ôn của chính nó.
///
/// Lịch suy ra từ `startedAt` chứ không lưu sẵn năm dòng ôn: ngày học đầu tiên
/// là ngày người dùng thật sự mở nó ra, không phải ngày tạo giáo trình. Lưu sẵn
/// lịch sẽ sai ngay khi người dùng nghỉ một tuần.
model VocabSet {
  id       String      @id @default(uuid())
  courseId String
  course   VocabCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  /// Ngày thứ mấy trong giáo trình, đếm từ 1.
  dayIndex Int
  /// JSON: [{ term, pos, phonetic, meaning, example, exampleTranslation }]
  words    String

  /// Lần đầu học. Null = chưa mở tới.
  startedAt      DateTime?
  /// Đã ôn lại bao nhiêu vòng, 0..5.
  cyclesDone     Int       @default(0)
  lastReviewedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([courseId, dayIndex])
  @@index([courseId, dayIndex])
}

/// Bài luyện đã sinh và giữ lại — dùng chung cho đọc và nghe.
///
/// Sinh lại mỗi lần mở thì vừa tốn lượt gọi AI, vừa khiến người học không quay
/// lại được đúng bài mình vừa làm sai.
model PracticeItem {
  id         String  @id @default(uuid())
  languageId String?
  /// reading | listening
  skill      String
  /// Cấp độ CEFR của bài.
  level      String
  topic      String?

  /// JSON: { passage | transcript, questions: [{prompt, options, correctIndex, explanation}] }
  content String

  attempts     Int       @default(0)
  correctCount Int       @default(0)
  lastDoneAt   DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, skill, level])
}

/// Một lượt luyện nói, kèm bản gỡ băng và nhận xét.
///
/// Không lưu file âm thanh: thu xong là gửi thẳng cho AI gỡ băng rồi vứt. Giữ
/// lại bản ghi âm của chính giọng mình trên máy chủ là thứ có rủi ro riêng tư mà
/// không đổi lại được lợi ích học tập nào — bản gỡ băng đã đủ để nhận xét.
model SpeakingAttempt {
  id         String  @id @default(uuid())
  languageId String?
  /// part1 | part2 | part3 — theo ba phần của bài thi nói.
  part       String  @default("part1")
  prompt     String

  transcript String
  seconds    Int    @default(0)

  band     Float?
  /// JSON: { fluency, lexis, grammar, pronunciation }
  criteria String?
  /// JSON: [{ quote, issue, better }]
  feedback String?
  summary  String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Một lượt thi thử đủ bốn kỹ năng.
///
/// Nội dung từng phần sinh khi người thi mở tới phần đó, không sinh sẵn cả bài:
/// một bài đủ bốn phần cần bảy lượt gọi AI, để người ta ngồi chờ hai phút trước
/// khi bắt đầu là hỏng cả cảm giác vào phòng thi. Đề và đáp án nằm trong
/// `sections`, và đáp án KHÔNG gửi xuống trình duyệt lúc phát đề.
model MockExam {
  id         String  @id @default(uuid())
  languageId String?

  /// JSON: { listening?, reading?, writing?, speaking? } — đề, đáp án, bài làm.
  sections String @default("{}")

  /// Số câu đúng trên 40. Null nghĩa là chưa làm phần đó.
  listeningRaw Int?
  readingRaw   Int?
  /// Band phần Viết và Nói do AI ước lượng.
  writingBand  Float?
  speakingBand Float?
  overallBand  Float?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

/// Tiến độ chép chính tả, ghi theo TỪNG CÂU.
///
/// Câu nằm trong code (`src/lib/dictation/`) chứ không trong bảng: bộ câu phải
/// đứng yên qua thời gian, vì tiến độ khoá theo `setId` + `index`. Bảng này chỉ
/// giữ thứ thuộc về người dùng.
model DictationLog {
  id         String  @id @default(uuid())
  languageId String?
  langCode   String
  /// Định danh bộ câu, ví dụ "cmn.hsk1.greetings".
  setId      String
  /// Vị trí câu trong bộ.
  index      Int

  attempts     Int     @default(0)
  /// Số lần gõ đúng trọn vẹn ngay lần thử đầu của một lượt.
  firstTry     Int     @default(0)
  /// Tỷ lệ khớp của lần gần nhất, 0-100.
  lastAccuracy Int     @default(0)
  /// Đã từng gõ đúng trọn vẹn câu này chưa.
  cleared      Boolean @default(false)

  lastDoneAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, langCode, setId, index])
  @@index([userId, langCode])
}

/// Tiến độ phần kết hợp từ, ghi theo TỪNG CÂU.
///
/// Câu nằm trong code (`src/lib/collocations/`) vì đây là dữ kiện về tiếng Anh
/// và phải ổn định; bảng này chỉ giữ thứ thuộc về người dùng.
model CollocationLog {
  id         String  @id @default(uuid())
  languageId String?
  langCode   String
  setId      String
  index      Int

  attempts Int     @default(0)
  cleared  Boolean @default(false)

  lastDoneAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, langCode, setId, index])
  @@index([userId, langCode])
}

/// Tiến độ đi trên đường học của một cuốn sách, ghi theo TỪNG BƯỚC.
///
/// Cấu trúc sách nằm trong code (`src/lib/books/`) vì nó là dữ kiện cố định;
/// bảng này chỉ giữ thứ thuộc về người dùng.
model BookStepProgress {
  id     String @id @default(uuid())
  bookId String
  /// Vị trí bước trên đường, khớp `BookStep.step`.
  step   Int

  /// Đã mở ra xem.
  openedAt DateTime?
  /// Tự đánh dấu là đã học xong.
  doneAt   DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([userId, bookId, step])
  @@index([userId, bookId])
}

/// Bài học và bài tập của một unit, sinh bằng AI rồi giữ lại.
///
/// Vì sao lưu: sinh một bài học mất hàng chục giây và ăn hạn mức. Mở lại unit
/// cũ mà sinh lại từ đầu thì vừa chậm vừa cho ra bài KHÁC lần trước — người học
/// quay lại để đọc lại đúng thứ họ đã đọc, không phải đọc một bản mới.
///
/// Theo từng người dùng vì nội dung viết bằng thứ tiếng người đó chọn để giải
/// thích, và vì mỗi người có thể muốn sinh lại bản của riêng mình.
model BookUnitContent {
  id     String @id @default(uuid())
  bookId String
  step   Int

  /// JSON: { summary, forms[], sections[], notes[] }
  lesson    String?
  /// JSON: { items[] } — bài tập do ứng dụng tự ra, KHÔNG chép đề của sách.
  exercises String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, bookId, step])
  @@index([userId, bookId])
}

/// Bài học và bài tập của một unit trong sách.
///
/// Sinh bằng AI rồi LƯU LẠI, không sinh mới mỗi lần mở: người học quay lại đọc
/// lại bài cũ, mà bài đổi mỗi lần mở thì không còn là bài của mình nữa. Cũng là
/// cách duy nhất để phần này dùng được khi hết hạn mức AI trong ngày.
///
/// Nội dung do ứng dụng soạn dựa trên TÊN UNIT và DANH SÁCH TỪ — hai thứ là dữ
/// kiện. Không chép giải thích, ví dụ hay đề bài của sách.
model BookLesson {
  id     String @id @default(uuid())
  bookId String
  step   Int

  /// JSON: { summary, sections: [{ heading, body, examples, note }] }
  lesson    String?
  /// JSON: [{ kind, prompt, options, answer, explanation }]
  exercises String?

  attempts     Int @default(0)
  correctCount Int @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, bookId, step])
  @@index([userId, bookId])
}

/// Điểm ngữ pháp rút từ một unit của sách, gộp vào mục Ngữ pháp.
///
/// Khung ngữ pháp chính nằm trong code vì thứ tự học cần ổn định. Nhưng sách
/// người dùng tải lên thì không biết trước, nên phần đến từ sách nằm ở bảng
/// này và được TRỘN VÀO khung lúc đọc. Hai nguồn, một đường đọc — nên không có
/// chuyện khung trong code và khung trên màn hình lệch nhau.
model BookGrammarNote {
  id String @id @default(uuid())

  langCode  String
  bookId    String
  /// Chép sẵn tên sách để hiện nhánh mà không phải tra sổ đăng ký sách.
  bookTitle String
  step      Int
  stepLabel String

  title      String
  level      String
  rule       String
  /// JSON: [{ pattern, note }]
  structures String @default("[]")
  /// JSON: [{ sentence, note }]
  examples   String @default("[]")

  /// Id điểm trong khung có sẵn mà điểm này trùng nội dung.
  /// Null = điểm sách có mà khung chưa có, sẽ hiện thành nhánh riêng của sách.
  syllabusPointId String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, bookId, step, title])
  @@index([userId, langCode])
  @@index([userId, syllabusPointId])
}
