generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User Profile table (mapped to Supabase Auth user id)
model User {
  id          String        @id // matches auth.users.id
  displayName String
  email       String        @unique
  role        String        @default("user")
  createdAt   DateTime      @default(now())
  Transaction Transaction[]
  Category    Category[]
  Budget      Budget[]
  Debt        Debt[]
  Material    Material[]
  DictionaryItem DictionaryItem[]
  Flashcard      Flashcard[]
  Idea           Idea[]
  DraftReceipt   DraftReceipt[]
  Vendor             Vendor[]
  ClassificationRule ClassificationRule[]
  OcrLog             OcrLog[]
  ExamAttempt        ExamAttempt[]
  VideoItem          VideoItem[]
  Asset              Asset[]
  Language           Language[]
  Deck               Deck[]
  ReviewLog          ReviewLog[]
  StudyNote          StudyNote[]
  DailyTask          DailyTask[]
  LearnerPref        LearnerPref?
}

// -----------------------------------------
// MODULE 1: FINANCE OS
// -----------------------------------------

model Transaction {
  id            String   @id @default(uuid())
  date          DateTime // receipt_date
  supplier      String
  type          String // Income | Expense | Transfer | Refund | Adjustment
  categoryGroup String // expense_group / income_group
  subGroup      String? // sub_group

  subtotal      Int @default(0)
  tax           Int @default(0)
  serviceCharge Int @default(0)
  discount      Int @default(0)
  totalAmount   Int

  paymentMethod String // cash | card | bank_transfer | e-wallet | unknown
  source        String // manual | ocr
  driveFileId   String?
  notes         String?

  userId String // owner
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items TransactionLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TransactionLine {
  id          String @id @default(uuid())
  productName String
  quantity    Float  @default(1)
  unitPrice   Int    @default(0)
  totalPrice  Int    @default(0)

  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

// Vùng chờ (staging) của luồng OCR hoá đơn.
//
// Bản cũ ghi bản nháp thành file `draft_<id>.json` trong thư mục Drive dùng
// chung: không lọc được theo người dùng, không có trạng thái, và mỗi lần mở
// hàng đợi phải tải từng file về để parse. Dự án "Sổ Chi Tiêu" trước đây dùng
// hai sheet Draft_Receipts/Draft_Items có cột `status` — đây là bản chuyển thể
// sang Postgres của đúng thiết kế đó.
//
// Vòng đời: Pending (vừa OCR xong, ảnh nằm ở Incoming_Invoices)
//        -> Approved (đã ghi Transaction, ảnh sang Approved_Invoices)
//        -> Rejected (người dùng bỏ, ảnh sang Trash_Invoices).
model DraftReceipt {
  id     String @id @default(uuid())
  status String @default("Pending") // Pending | Approved | Rejected

  // Mọi trường OCR đều nullable: nguyên tắc bất di bất dịch của luồng cũ là
  // "đọc không ra thì để null, không bao giờ đoán".
  date          DateTime?
  supplier      String?
  type          String    @default("Expense")
  categoryGroup String?
  subGroup      String?

  subtotal      Int?
  tax           Int?
  serviceCharge Int?
  discount      Int?
  totalAmount   Int?

  paymentMethod String? // cash | card | bank_transfer | e-wallet | unknown
  language      String? // vi | en | mixed
  notes         String?

  // Danh sách fileId trên Drive, phân tách bằng dấu phẩy (một hoá đơn dài có
  // thể được chụp thành nhiều ảnh).
  driveFileIds  String
  driveFileName String?

  // Giao dịch được sinh ra khi duyệt. Giữ lại để nút "xoá giao dịch vừa tạo"
  // trong hộp thoại trùng lặp biết phải xoá bản ghi nào.
  transactionId String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items DraftItem[]

  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, status])
}

model DraftItem {
  id          String @id @default(uuid())
  productName String
  quantity    Float  @default(1)
  unitPrice   Int    @default(0)
  totalPrice  Int    @default(0)

  // Gemini đề xuất nhóm chi tiêu cho từng dòng kèm độ tin cậy. Chưa dùng để tự
  // động phân loại, nhưng lưu sẵn để sau này port Classification_Rules.
  suggestedCategoryGroup String?
  confidence             Float?

  draftId String
  draft   DraftReceipt @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
}

// Nhà cung cấp đã gặp, dựng dần từ các hoá đơn đã duyệt.
//
// `normalizedName` là tên đã bỏ dấu/hạ chữ thường (xem normalizeSupplier trong
// src/lib/invoice.ts) — vừa dùng để chống trùng, vừa là khoá so khớp quy tắc.
model Vendor {
  id                   String  @id @default(uuid())
  vendorName           String
  normalizedName       String
  defaultCategoryGroup String?
  notes                String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, normalizedName])
}

// Quy tắc tự phân loại hoá đơn.
//
// Hệ "Sổ Chi Tiêu" chạy theo thứ tự: quy tắc trước, Gemini là phương án dự
// phòng, và mỗi lần người dùng sửa tay có thể lưu lại thành quy tắc mới
// (source = "learned"). Đây là bản chuyển thể của sheet Classification_Rules.
model ClassificationRule {
  id String @id @default(uuid())

  // vendor | product_keyword | note_keyword
  matchType String
  // Luôn lưu ở dạng đã chuẩn hoá để so khớp không phụ thuộc dấu và chữ hoa.
  matchValue String

  transactionType String?
  categoryGroup   String
  subGroup        String?

  // Số nhỏ được xét trước. Quy tắc học được đặt 50, quy tắc gõ tay mặc định 100,
  // nên một lần sửa tay gần đây luôn thắng quy tắc chung chung cũ.
  priority Int     @default(100)
  active   Boolean @default(true)
  source   String  @default("manual") // manual | learned

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, active, priority])
}

// Nhật ký OCR — trước đây mọi lỗi Gemini chỉ nằm trong console của server, nên
// không có cách nào biết hoá đơn nào hỏng, hỏng vì sao, hay mất bao lâu.
model OcrLog {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())

  fileId     String?
  fileName   String?
  status     String // OK | ERROR | INFO
  message    String
  durationMs Int?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
}

// Một lượt thi thử sinh ra từ một tài liệu.
//
// Tab Thi thử trước đây liệt kê ba đề viết cứng ("CFA Level 1 - Mock Exam A",
// 135 phút, 90 câu) không hề tồn tại ở đâu, và nút Bắt đầu không có handler.
// Đề giờ được sinh từ chính tài liệu người dùng đang học.
//
// Câu hỏi lưu nguyên cụm JSON thay vì tách bảng riêng: đề là ảnh chụp một lần,
// không phải ngân hàng câu hỏi dùng lại — tách bảng chỉ thêm việc mà không thêm
// khả năng nào.
model ExamAttempt {
  id String @id @default(uuid())

  sourceFileId String
  sourceName   String

  questionCount Int
  correctCount  Int  @default(0)
  completed     Boolean @default(false)

  /// JSON: [{ question, options[], correctIndex, explanation, chosenIndex }]
  questions String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId, createdAt])
}

// Video lưu từ TikTok / Facebook / YouTube.
//
// Ứng dụng KHÔNG tự tải video: nó chạy trên Vercel, nơi hệ thống file chỉ đọc,
// function bị giới hạn 60 giây và không cài được yt-dlp. Điện thoại tải qua một
// Shortcut, rồi đẩy file lên `/api/video/upload`.
//
// Bảng này giữ phần mà Drive không giữ được: link gốc, nền tảng, và đề tài —
// đúng ba thứ khiến một video lưu 6 tháng trước vẫn còn tra lại được.
model VideoItem {
  id String @id @default(uuid())

  sourceUrl String
  // tiktok | facebook | youtube | instagram | other
  platform  String
  topic     String
  // Nhãn phân loại con, do người dùng tự gõ: đề tài "3D Design" có "Mẫu thiết
  // kế", "Hướng dẫn in", "Trick in"...
  //
  // Cố tình KHÔNG tạo thư mục Drive lồng thêm một tầng: Shortcut trên iPhone
  // chỉ chọn được đề tài cấp một, thêm tầng nữa là mọi lượt upload rơi vào sai
  // chỗ. Đây là nhãn thuần trong DB, dùng để lọc và gom nhóm ở giao diện, nên
  // đổi tên nhãn không đụng gì tới file đã nằm trên Drive.
  subTopic  String?
  title     String?
  note      String?

  // pending: đã dán link, chờ Shortcut đẩy file lên
  // saved:   file đã nằm trên Drive
  status String @default("pending")

  driveFileId   String?
  driveFileName String?
  sizeBytes     Int?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  savedAt   DateTime?

  @@index([userId, status])
  @@index([userId, topic])
}

model Category {
  id   String @id @default(uuid())
  kind String // expense_group | income_group

  // `name` là tên CHUẨN: Transaction.categoryGroup, Budget.categoryGroup,
  // Vendor.defaultCategoryGroup và ClassificationRule.categoryGroup đều khớp
  // với nó bằng chuỗi. Đổi `name` là phải dời cả bốn bảng đó.
  //
  // Giữ tiếng Anh làm chuẩn vì process-ocr có fallback viết cứng "Other", và
  // dữ liệu sẵn có đều dùng tên tiếng Anh.
  name String
  // Nhãn tiếng Việt, chỉ dùng để hiển thị. Rỗng thì giao diện lùi về `name`.
  nameVi String?

  active   Boolean    @default(true)
  parentId String?
  parent   Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children Category[] @relation("SubCategories")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Budget {
  id            String  @id @default(uuid())
  periodType    String // monthly | yearly
  period        String // YYYY-MM | YYYY
  categoryGroup String // matches Category.name
  amount        Int
  notes         String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -----------------------------------------
// MODULE 2 & 3: KNOWLEDGE HUB & LEARNING HUB
// -----------------------------------------

// Tài liệu trong Knowledge Hub, đồng thời là nơi cache văn bản đã trích ra.
//
// Bảng này trước đây hoàn toàn trống và không có chỗ nào ghi vào: module
// Knowledge đọc thẳng từ Drive, còn khung chat chỉ gửi cho AI mỗi cái TÊN file.
// Nay mỗi lần mở một tài liệu, nội dung được trích một lần rồi lưu ở đây, nên
// những câu hỏi sau không phải tải lại file và không tốn thêm quota Gemini.
model Material {
  id          String   @id @default(uuid())
  driveFileId String   @unique
  title       String
  type        String   // e.g. "pdf"
  domain      String?
  mimeType    String?

  // Văn bản đã trích (Google Docs/Sheets, .docx/.xlsx, .txt/.md). Cache hợp lệ
  // khi `sourceModifiedAt` còn khớp `modifiedTime` bên Drive — file sửa trên
  // Drive thì tự trích lại.
  contentText      String?
  contentChars     Int?
  sourceModifiedAt DateTime?
  contentFetchedAt DateTime?

  // PDF và ảnh không chép ra text mà đẩy thẳng lên Gemini Files API: chép toàn
  // văn một PDF 7,67 MB mất 260 giây, còn upload chỉ 2,8 giây. Gemini giữ tệp
  // 48 giờ, hết hạn thì lần mở sau tự đẩy lại.
  geminiFileUri       String?
  geminiFileName      String?
  geminiFileExpiresAt DateTime?

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  annotations DocumentAnnotation[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DocumentAnnotation {
  id          String   @id @default(uuid())
  content     String
  position    String   // JSON string
  comment     String?

  materialId  String
  material    Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Idea / Project Tracker.
//
// Trước đây IdeaTrackerTab.tsx render một mảng 3 dự án viết cứng và không nút
// nào có onClick — tính năng hoàn toàn không có nền tảng dữ liệu.
model Idea {
  id           String   @id @default(uuid())
  title        String
  description  String?
  // active | completed | archived
  status       String   @default("active")
  // Mốc để tính "bỏ trống > 30 ngày". Bản cũ dùng cờ `stale` viết cứng.
  lastActiveAt DateTime @default(now())
  // Dàn ý do /api/ai/blueprint sinh ra, lưu lại để khỏi gọi AI nhiều lần.
  blueprint    String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

model DictionaryItem {
  id                 String   @id @default(uuid())
  term               String
  definition         String
  phonetic           String?
  example            String?
  domain             String?
  tags               String[]
  crossDomainLinks   String?  // JSON string

  // ── Phần thêm cho module ngôn ngữ ──────────────────────────────────────
  // `phonetic` giữ nguyên vai trò "cách đọc", nhưng đọc theo hệ nào là do
  // Language.phoneticSystem quyết định: IPA cho Anh/Pháp, Pinyin cho Quan
  // Thoại, Jyutping cho Quảng Đông, Romaja cho Hàn. Nhờ vậy không phải đẻ ra
  // mỗi tiếng một cột.
  tone               String?  // "3", "2-1"... chỉ dùng cho tiếng có thanh điệu
  exampleTranslation String?  // bản dịch câu ví dụ
  imageUrl           String?  // ảnh minh hoạ cho thẻ
  audioUrl           String?  // file phát âm mẫu
  orderIndex         Int      @default(0)

  deckId             String?
  deck               Deck?     @relation(fields: [deckId], references: [id], onDelete: SetNull)
  languageId         String?
  language           Language? @relation(fields: [languageId], references: [id], onDelete: SetNull)

  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  flashcard          Flashcard?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Flashcard {
  id             String   @id @default(uuid())
  front          String
  back           String
  
  // FSRS Algorithm Fields
  stability      Float    @default(0)
  difficulty     Float    @default(0)
  elapsedDays    Int      @default(0)
  scheduledDays  Int      @default(0)
  reps           Int      @default(0)
  state          Int      @default(0) // 0: New, 1: Learning, 2: Review, 3: Relearning
  lastReview     DateTime?
  dueDate        DateTime @default(now())

  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  itemId         String?  @unique
  dictionaryItem DictionaryItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Debt {
  id              String   @id @default(uuid())
  name            String
  type            String   // Mortgage, Auto Loan, Personal, Credit Card, etc.
  startDate       DateTime
  dueDate         DateTime?
  principal       Int
  remaining       Int
  monthlyPayment  Int
  interestRate    Float
  status          String   @default("active") // active | settled

  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  schedule        DebtSchedule[]

  // Tài sản mà khoản vay này dùng để mua, hoặc đem thế chấp.
  //
  // Chiều quan hệ đặt ở đây chứ không phải ở `Asset.debtId`: MỘT tài sản có thể
  // gánh NHIỀU khoản vay. Căn nhà này vừa có khoản vay mua nhà vừa có khoản vay
  // thế chấp lấy thêm tiền — để một chiều thì vốn chủ sở hữu tính thiếu nguyên
  // một khoản nợ mà không báo gì.
  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Lịch trả nợ từng kỳ.
//
// `Debt` chỉ giữ được một dòng tóm tắt, không đủ cho khoản vay gốc đều lãi thả
// nổi: mỗi kỳ có ngày đến hạn riêng (mùng 10, lùi về thứ Sáu nếu rơi cuối
// tuần), số ngày tính lãi riêng, và lãi suất riêng — khoản vay mua nhà đã đổi
// lãi 16 lần trong 76 kỳ đầu.
//
// Lãi = openingBalance × interestRate × interestDays / 365. Công thức này khớp
// tới từng đồng với bảng của ngân hàng.
//
// `status` phân biệt kỳ ĐÃ CHỐT với kỳ TẠM TÍNH. Kỳ tạm tính dựng theo giả định
// lãi suất hiện hành giữ nguyên tới hết — giả định gần như chắc chắn sai với
// lãi thả nổi, nên giao diện phải nói rõ, không được trình bày như số thật.
//
// Mọi cột đều sửa được, kể cả kỳ quá khứ: khi thương lượng được khoản hoàn thì
// cấn trừ ngược vào kỳ cũ, và các kỳ sau được tính lại từ dư nợ mới.
model DebtSchedule {
  id             String   @id @default(uuid())

  debtId         String
  debt           Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)

  period         Int      // 1..tenor
  dueDate        DateTime
  interestDays   Int
  openingBalance Int      // dư nợ đầu kỳ
  principal      Int
  interest       Int
  payment        Int      // principal + interest
  closingBalance Int      // dư nợ cuối kỳ
  interestRate   Float    // %/năm áp cho kỳ này
  status         String   @default("projected") // paid | projected
  note           String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([debtId, period])
  @@index([debtId, dueDate])
}

// Tài sản và công cụ dụng cụ.
//
// Có hai loại giá trị và đừng lẫn chúng:
//
//   GIÁ TRỊ SỔ SÁCH — nguyên giá trừ khấu hao luỹ kế. Dùng cho thiết bị: laptop
//   mua 30 triệu, đời hữu dụng 4 năm, sau 2 năm còn 15 triệu trên sổ.
//
//   GIÁ TRỊ ĐỊNH GIÁ (`currentValue`) — số bạn tự đặt khi biết giá thị trường.
//   Bất động sản không khấu hao mà lên xuống theo thị trường, nên nhà thì dùng
//   ô này. Có `currentValue` thì nó đè lên giá trị sổ sách.
//
// VỐN CHỦ SỞ HỮU của một tài sản mua bằng nợ = giá trị hiện tại − dư nợ còn
// lại của khoản vay gắn với nó. Trả gốc KHÔNG làm tài sản đắt lên, nó làm nợ
// nhỏ đi — vốn chủ sở hữu tự tăng đúng bằng số đó. Cộng gốc vào giá trị tài
// sản là đếm hai lần.
model Asset {
  id       String @id @default(uuid())
  name     String
  // Real Estate | Vehicle | Electronics | Furniture | Equipment | Other
  category String

  acquisitionDate DateTime
  acquisitionCost Int

  // straight_line | none. `none` dành cho thứ không mòn theo sổ sách (nhà, đất).
  depreciationMethod String @default("straight_line")
  // 0 nghĩa là không khấu hao, bất kể `depreciationMethod`.
  usefulLifeMonths   Int    @default(0)
  // Giá trị còn lại khi hết đời hữu dụng; khấu hao không bao giờ ăn xuống dưới mức này.
  salvageValue       Int    @default(0)

  // Định giá lại. Có giá trị thì đè lên giá trị sổ sách.
  currentValue  Int?
  valuationDate DateTime?

  // owned | sold | written_off
  status         String    @default("owned")
  disposalDate   DateTime?
  disposalAmount Int?

  // Các khoản vay gắn với tài sản này. Xem chú thích ở `Debt.assetId`.
  debts Debt[]

  notes String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════
//  MODULE NGÔN NGỮ
//
//  Learning Hub phải chạy được cho tiếng Anh, Quan Thoại, Quảng Đông, Hàn và
//  Pháp — năm thứ tiếng có hình dạng rất khác nhau:
//
//    Anh / Pháp     chữ Latin,  phiên âm IPA,      không thanh điệu
//    Quan Thoại     chữ Hán,    phiên âm Pinyin,   4 thanh + thanh nhẹ
//    Quảng Đông     chữ Hán,    phiên âm Jyutping, 6 thanh
//    Hàn            Hangul,     phiên âm Romaja,   không thanh điệu
//
//  Nếu viết cứng theo tiếng Anh thì thêm tiếng thứ hai là phải đập đi làm lại.
//  Nên chỗ khác nhau được đẩy hết vào cấu hình của `Language`, còn thẻ từ vựng
//  giữ đúng một hình dạng chung. Thêm tiếng thứ sáu = thêm một dòng dữ liệu.
// ═══════════════════════════════════════════════════════════════════════════

/// Một thứ tiếng đang học, kèm những quy ước riêng của nó.
model Language {
  id         String  @id @default(uuid())
  code       String  // en, fr, cmn (Quan Thoại), yue (Quảng Đông), ko
  name       String  // tên hiển thị, ví dụ "Tiếng Quảng Đông"
  nativeName String? // 廣東話, 한국어...

  /// latin | hanzi | hangul — quyết định có bật phần luyện viết chữ hay không.
  script         String  @default("latin")
  /// ipa | pinyin | jyutping | romaja — nhãn hiện trên ô "cách đọc".
  phoneticSystem String  @default("ipa")
  /// Có thanh điệu thì mới hiện phần luyện thanh.
  hasTones       Boolean @default(false)
  toneCount      Int     @default(0)
  /// CEFR | HSK | TOPIK — thang cấp độ dùng để xếp bộ thẻ.
  levelScale     String  @default("CEFR")

  sortOrder Int     @default(0)
  active    Boolean @default(true)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  decks Deck[]
  items DictionaryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, code])
}

/// Bộ thẻ. Dùng cho cả ngôn ngữ lẫn các lĩnh vực khác.
///
/// `languageId` và `domain` loại trừ nhau: bộ thuộc một thứ tiếng, hoặc thuộc
/// một lĩnh vực (Finance, 3D Design...). Để chung một bảng là có chủ ý — khi
/// nhân bản logic sang lĩnh vực khác thì không phải viết lại gì.
model Deck {
  id          String  @id @default(uuid())
  name        String
  description String?
  level       String? // A1..C2, HSK1.., TOPIK1..
  topic       String?

  /// Vị trí trong lộ trình. Học xong bộ này mới mở bộ có orderIndex kế tiếp.
  orderIndex  Int       @default(0)
  /// active | paused — bộ tạm dừng không đưa thẻ vào hàng ôn hằng ngày.
  status      String    @default("active")
  isPreset    Boolean   @default(false)
  completedAt DateTime?

  languageId String?
  language   Language? @relation(fields: [languageId], references: [id], onDelete: Cascade)
  domain     String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items DictionaryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, languageId, orderIndex])
  @@index([userId, domain])
}

/// Nhật ký từng lượt ôn.
///
/// `Flashcard` chỉ giữ trạng thái hiện tại của thẻ, nên không trả lời được
/// "hôm 12/08 đã học những gì". Bảng này ghi lại từng lượt để dựng lịch sử
/// dạng lịch tháng, biểu đồ thống kê, và chuỗi ngày học.
model ReviewLog {
  id          String  @id @default(uuid())
  flashcardId String?
  itemId      String?
  deckId      String?
  languageId  String?

  grade Int // 1..4 theo thang FSRS
  state Int // trạng thái thẻ SAU lượt ôn này
  /// flashcard | quick | fill | listen | tone | write | pronounce
  mode  String  @default("flashcard")
  correct Boolean?

  reviewedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, reviewedAt])
  @@index([userId, languageId, reviewedAt])
}

/// Giấy nhớ, gắn với một ngày cụ thể để xem lại cùng lịch sử học.
model StudyNote {
  id       String   @id @default(uuid())
  body     String
  noteDate DateTime
  color    String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, noteDate])
}

/// Việc cần làm trong ngày, và thử thách hằng ngày.
model DailyTask {
  id       String   @id @default(uuid())
  taskDate DateTime
  /// review | newCards | listen | pronounce | read | pomodoro | challenge
  kind     String
  label    String?
  target   Int      @default(1)
  progress Int      @default(0)
  reward   Int      @default(0)
  visible  Boolean  @default(true)
  color    String?

  completedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, taskDate])
}

/// Tuỳ chọn học và phần thưởng của người dùng.
///
/// Gom một dòng cho mỗi người thay vì rải cột vào `User` — phần này còn phình
/// thêm khi làm tới ảnh nền, hiệu ứng và cửa hàng.
model LearnerPref {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Phần thưởng
  diamonds      Int @default(0)
  streakShields Int @default(0)

  // Không gian học
  background          String?  // ảnh nền đang dùng
  unlockedBackgrounds String[] // những ảnh đã mở khoá
  videoBackground     String?
  weatherEffect       String   @default("none")
  contentAlign        String   @default("center")
  colorTheme          String   @default("default")

  // Cách học
  newCardLimit      Int     @default(10)
  relearnLimit      Int     @default(20)
  skipExerciseOnNew Boolean @default(true)
  lowercaseAnswers  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
